# Personalized Learning Path Recommender - Environment Configuration

# Application Security
SECRET_KEY=change-me-in-production-32-chars!!

# ─────────────────────────── Free AI Model API Keys ───────────────────────────
# You can set these globally here, OR configure them per-user directly in the UI!
#
# 1. Google Gemini (Free tier with 15 RPM / 1M TPM on Google AI Studio):
#    Get key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# 2. Groq Cloud (Free ultra-fast inference for Meta Llama 3.3 & Mixtral):
#    Get key: https://console.groq.com/keys
GROQ_API_KEY=

# 3. OpenRouter (Free tier models like DeepSeek R1, Llama 3.3, Mistral):
#    Get key: https://openrouter.ai/keys
OPENROUTER_API_KEY=
